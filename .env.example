# Database
DATABASE_URL=.data/wa-blast.db

# Better Auth
BETTER_AUTH_SECRET=change_me_32_byte_base64_secret_xxxxxxxxxxx
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=re_change_me
EMAIL_FROM="wa-blast <no-reply@example.com>"

# Encryption at rest (32-byte base64)
ENCRYPTION_KEY=change_me_32_byte_base64_key_xxxxxxxxxxxxxx

# Signup control
DISABLE_SIGNUP=false

# Meta App (optional)
META_APP_ID=
META_APP_SECRET=
