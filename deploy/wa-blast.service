[Unit]
Description=wa-blast (Next.js, Node)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/wa-blast
# .env.local lo lee Next; PORT/HOSTNAME fuerzan bind local (nunca 0.0.0.0 — kinsing may-2026)
Environment=NODE_ENV=production
Environment=PORT=3010
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 3010 -H 127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
